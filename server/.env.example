# Server-side variables of the signaling / REST server.
#
# The server loads its environment through `server/env.ts` in this order
# (the first file that defines a key wins):
#   1. `<repo root>/.env`        – the canonical file, copy `.env.example` there
#   2. `<repo root>/server/.env` – THIS file: fallback for keys the root file
#                                  does not define
#   3. `<cwd>/.env`              – legacy location
#
# So the usual setup is: copy the root `.env.example` to `.env` in the repo
# root. This file only exists so the server variables can also be kept next to
# the server code (handy when the root file is managed by another tool).
#
# The full list, with the same comments, lives in the root `.env.example`.

# JWT signing key for admin sessions. Relay connection tokens are signed with a
# key derived from it (HMAC domain separator), so an admin token can never be
# used as a relay token and vice versa. Must be >= 32 chars and not a placeholder
# (the server refuses to start otherwise).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-secure-string

# WebSocket port and REST port of the signaling server.
PORT=8765
REST_PORT=8766

# SQLite database of the admin panel. Must live inside the `data/` directory.
DB_PATH=./data/admin.db

# Optional: sign relay tokens with a dedicated key instead of the one derived
# from JWT_SECRET. Must differ from JWT_SECRET.
RELAY_JWT_SECRET=""

# Comma-separated list of origins allowed to call the REST API (CORS).
# Unset = same-origin only.
ALLOWED_ORIGINS=""

# Proxies whose X-Forwarded-For / X-Real-IP headers may be trusted for client-IP
# resolution (rate limiting, connection log). Unset = loopback only.
TRUSTED_PROXIES=""

# How long connection log entries are kept, in days.
CONNECTION_LOG_RETENTION_DAYS=30

# Port of the optional public signalling-seed registry.
SEED_REGISTRY_PORT=3001

# Paymento crypto payment gateway integration (https://paymento.io).
# Leave empty to disable payments (server answers 503 on create/verify).
PAYMENTO_API_URL="https://api.paymento.io"
PAYMENTO_API_KEY=""
PAYMENTO_SECRET_KEY=""
PAYMENTO_RETURN_URL=""
