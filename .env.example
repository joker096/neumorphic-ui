# ─────────────────────────────────────────────────────────────
# One env file for the whole app: copy to `.env` in the repo root.
#
# The signaling server reads it through `server/env.ts` in this order
# (first definition wins): `./.env` → `./server/.env` → `<cwd>/.env`.
# The SPA reads the `VITE_*` variables at build time (Vite inlines them).
# ─────────────────────────────────────────────────────────────

# ── Client (Vite build-time variables) ─────────────────────────
# Signalling seeds (client, optional). Comma-separated `wss://` endpoints.
# Unset = the client dials its own origin (`wss://<host>/ws`), which every
# standard nginx server deployment terminates (see server/*.conf).
VITE_SIGNALING_SEED_URLS=""
# Relay-proxy endpoint (client, optional). Set by deploy-all.ps1 phase 0 when a
# Cloudflare relay host is configured. Without it the SPA hides the relay-backend
# setting and always connects direct.
VITE_RELAY_PROXY_URL=""
# REST endpoint that hands out relay tokens. Unset = the same origin as the app.
VITE_SIGNALING_REST_URL=""
# Base url of the embeddable chat widget (the `embed.js` bundle). Unset = the
# widget is served from the app origin.
VITE_EMBED_WIDGET_URL=""
# Development switch: seed mock data instead of talking to a real peer.
# Never enable it in a production build.
VITE_USE_MOCK=""

# ── Signaling / REST server (operator) ─────────────────────────
# JWT signing key for admin sessions. Relay connection tokens are signed with a
# key derived from it (HMAC domain separator), so an admin token can never be
# used as a relay token and vice versa. Must be >= 32 chars and not a placeholder
# (the server refuses to start otherwise).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
# Optional: sign relay tokens with a dedicated key instead of the derived one.
# Must differ from JWT_SECRET (the server rejects an identical value).
RELAY_JWT_SECRET=""
# Comma-separated list of origins allowed to call the REST API (CORS).
# Unset = same-origin only.
ALLOWED_ORIGINS=""
# Proxies whose X-Forwarded-For / X-Real-IP headers may be trusted for client-IP
# resolution (rate limiting, connection log). Comma-separated. Unset = loopback
# only, which is correct when nginx runs on the same host. Add every hop when a
# CDN/load balancer sits in front — an untrusted peer's header is ignored, so a
# client can never spoof its own bucket.
TRUSTED_PROXIES=""
# WebSocket port and REST port of the signaling server.
PORT=8765
REST_PORT=8766
# SQLite database of the admin panel. Must live inside the `data/` directory.
DB_PATH=./data/admin.db
# How long connection log entries are kept, in days.
CONNECTION_LOG_RETENTION_DAYS=30
# Port of the optional public signalling-seed registry.
SEED_REGISTRY_PORT=3001
# Paymento crypto payment gateway integration (https://paymento.io).
# Server-side operator credentials used by the /api/paymento backend proxy.
# Leave empty to disable payments (server answers 503 on create/verify).
PAYMENTO_API_URL="https://api.paymento.io"
PAYMENTO_API_KEY=""
PAYMENTO_SECRET_KEY=""
# Optional: default ReturnUrl sent to the gateway when the client does not send one.
PAYMENTO_RETURN_URL=""

# ── Release pipeline (operator) ─────────────────────────────────────
# Read by scripts/release.mjs (npm run release / npm run verify).
