{
  "name": "mess-andanger",
  "private": true,
  "version": "1.0.0",
  "description": "Mesh-powered decentralized messenger with post-quantum encryption, forward secrecy, store-and-forward, and multi-hop relay. Neumorphic UI.",
  "homepage": "https://mess.cvr.name",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:web": "pwsh -NoProfile -File scripts/build-web.ps1",
    "build:android": "node scripts/build-android.mjs",
    "build:ios": "node scripts/build-ios.mjs",
    "build:all": "node scripts/build-android.mjs",
    "deploy": "pwsh -NoProfile -File scripts/deploy-all.ps1",
    "deploy:web": "pwsh -NoProfile -File scripts/deploy-all.ps1 -SkipAndroid -SkipSignaling",
    "deploy:ios": "node scripts/build-ios.mjs",
    "deploy:android": "node scripts/build-android.mjs",
    "deploy:quick": "pwsh -NoProfile -File scripts/deploy-all.ps1 -SkipTests -SkipAndroid",
    "deploy:server": "pwsh -NoProfile -File scripts/deploy-all.ps1 -SkipBuild -SkipAndroid",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint . --quiet && tsc --noEmit",
    "test": "vitest run",
    "test:usability": "playwright test e2e/usability.spec.ts",
    "test:e2e": "playwright test",
    "admin:create": "npx tsx server/cli.ts",
    "build:admin": "pwsh -NoProfile -File scripts/build-admin.ps1"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.6.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-virtual": "^3.14.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "idb-keyval": "^6.2.4",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.40.0",
    "nanoid": "^5.1.5",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@bubblewrap/core": "^1.24.1",
    "@playwright/test": "^1.61.1",
    "@scure/bip39": "^2.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/ui": "^4.1.8",
    "esbuild": "^0.25.0",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.8"
  }
}
